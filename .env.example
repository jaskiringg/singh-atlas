# OpenRouter — get a key at https://openrouter.ai/keys (free models supported)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free model router (auto-picks a free model). Override if needed.
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Your public site URL (for OpenRouter attribution)
SITE_URL=http://localhost:3456

# Admin dashboard password — set something strong
ADMIN_SECRET=change-me-to-a-long-random-string

# Optional — persistent data directory (use a Railway volume in production)
# DATA_DIR=/data
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Connect-request alerts + durable storage
# DATABASE_URL — Railway: reference the Postgres service, ${{Postgres.DATABASE_URL}}
DATABASE_URL=
# Resend (free tier covers this easily). Without it, nothing emails you.
RESEND_API_KEY=
CONTACT_NOTIFY_EMAIL=singhjass6404@gmail.com
# Override once a sending domain is verified; the default needs no DNS setup.
CONTACT_NOTIFY_FROM=Atlas <onboarding@resend.dev>
# Optional: POST every lead somewhere you already watch
CONTACT_WEBHOOK_URL=
